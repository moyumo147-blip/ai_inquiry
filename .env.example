# AI 问诊系统 · 环境变量模板
# 复制为 .env.local 后填写真实值（.env.local 已在 .gitignore 中）

# ── PostgreSQL（知识库与业务表共用同一个库）──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=你的数据库密码

# ── 阿里云百炼 DashScope（OpenAI 兼容模式）──
# 同一个 Key 同时用于：对话（qwen-plus / qwen-max）+ 查询向量化（text-embedding-v2）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
CHAT_MODEL_STRONG=qwen-max
# 必须与知识库入库时使用的 embedding 模型一致，否则向量空间不匹配
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIM=1536

# ── JWT ──
JWT_SECRET_KEY=请替换为随机字符串
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 应用 ──
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 前端开发地址（CORS 白名单，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 检索参数（可选）──
RETRIEVAL_CANDIDATES=40
RETRIEVAL_TOP_K=6
MIN_CONFIDENCE=0.35

# ── 长会话摘要（可选）──
SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_KEEP_RECENT=6
